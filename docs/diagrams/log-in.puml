@startuml log-in
'
' PlatePal - "Log in".
'
' Code: platepal.service.AuthService#login (AuthService.java:32)
'

title PlatePal - Log in

skinparam responseMessageBelowArrow true
skinparam shadowing false
hide footbox

actor Visitor

participant "menu :\nAuthMenu" as menu
participant "ac :\nAuthController" as ac
participant "auth :\nAuthService" as auth
participant "user :\nUser" as user
participant "userRepo :\nUserRepository" as userRepo

Visitor -> menu ++ : submit credentials(username, password)
menu -> ac ++ : login(username, password)
ac -> auth ++ : login(username, password)

auth -> userRepo ++ : findByUsername(username)
userRepo --> auth -- : Optional<User>

opt a user with that name exists
    auth -> user ++ : matchesPassword(password)
    user --> auth -- : matches
end

alt unknown username, or wrong password
    auth --> ac : Optional.empty()
    ac --> menu : Optional.empty()
    menu -> Visitor : "Invalid username or password."

else credentials match
    auth -> auth : startSession(user)
    auth --> ac -- : Optional<User>
    ac --> menu -- : Optional<User>
    menu -> Visitor : "Welcome back, <name>!"
end

deactivate menu

@enduml
